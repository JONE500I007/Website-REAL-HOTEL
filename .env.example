# Read by docker-compose.yml itself (Docker Compose auto-loads a ".env"
# file from the same directory as the compose file) to fill in the MySQL
# container's credentials. This is separate from php/src/.env, which the
# PHP app reads at runtime — the DB_USER/DB_PASSWORD/DB_NAME values here
# must match what you put in php/src/.env.
#
# Copy this file to ".env" in the repo root and fill in real values before
# running `docker compose up`. Never commit the real ".env".

DB_ROOT_PASSWORD=change_me_to_a_strong_password
DB_NAME=my_database
DB_USER=change_me
DB_PASSWORD=change_me_to_a_strong_password
